# Alterford operator environment

# WalletConnect / frontend
VITE_WALLETCONNECT_PROJECT_ID=
VITE_WEB3AUTH_CLIENT_ID=
VITE_WEB3AUTH_NETWORK=sapphire_devnet
VITE_GATEWAY_URL=http://127.0.0.1:8790

# Phase 2 gateway (server only; never prefix secrets with VITE_)
ALTERFORD_FORWARDER_ADDRESS=
CHALLENGE_FACTORY_ADDRESS=
RELAY_PROVIDER=biconomy
GELATO_API_KEY=
GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
GATEWAY_LEDGER_PATH=data/sponsorship-ledger.json
TRANSAK_API_KEY=
TRANSAK_API_SECRET=
TRANSAK_REFERRER_DOMAIN=
TRANSAK_ENVIRONMENT=staging

# Deprecated native Monero custody rail. Keep disabled; retained for historical test compatibility only.
MONERO_RPC_URL=
MONERO_RPC_USERNAME=
MONERO_RPC_PASSWORD=
MONERO_ACCOUNT_INDEX=0
MONERO_NETWORK=stagenet
MONERO_LEDGER_PATH=data/monero-ledger.json
MONERO_MIN_CONFIRMATIONS=10
MONERO_SYNC_INTERVAL_MS=30000
MONERO_GATEWAY_ID=
MONERO_SYNC_TOKEN=
MONERO_WITHDRAWALS_ENABLED=false

# Non-custodial XMR -> USDC on Base conversion (server only)
# Enable only on Base Mainnet after configuring durable storage and a supported provider account.
XMR_CONVERSION_PROVIDER=disabled
XMR_ASSISTED_THRESHOLD_MINOR=1500000000
XMR_SETTLEMENT_TOKEN_ADDRESS=
XMR_SETTLEMENT_CONFIRMATIONS=12
XMR_CONVERSION_LEDGER_PATH=/data/xmr-conversion-ledger.json
XMR_PROVIDER_BASE_URL=https://sideshift.ai/api/v2
XMR_PROVIDER_ACCOUNT_ID=
XMR_PROVIDER_SECRET=
XMR_OPERATOR_TOKEN=
BASE_MAINNET_RPC_URL=

SECURITY_COUNCIL_ADDRESS=
COLD_WALLET_ADDRESS=
SETTLEMENT_TOKEN_ADDRESS=
CREATION_BOND_POLICY_ADDRESS=
VITE_BOND_CONTEXT_RESOLVER_ADDRESS=
VITE_APP_URL=http://127.0.0.1:5173
VITE_INDEXER_URL=http://127.0.0.1:8787

# Local Anvil
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Base Sepolia
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
FOUNDRY_ACCOUNT=alterford-base-sepolia
FOUNDRY_PASSWORD_FILE=
BASESCAN_API_KEY=

# Indexer
MARKET_FACTORY_ADDRESS=0x
INDEXER_STORE=data/alterford-31337.json
CONFIRMATIONS=0
PORT=8787
POLL_INTERVAL_MS=12000

# Security gate
SECURITY_STRICT=0

# Decentralized static web publishing (server-side scripts only)
PINNING_PROVIDER=pinata
EVIDENCE_PINNING_PROVIDER=pinata
EVIDENCE_PINNING_TOKEN=
EVIDENCE_PINNING_API_URL=https://api.pinata.cloud/pinning/pinFileToIPFS
EVIDENCE_PINNING_PROJECT_ID=
EVIDENCE_UPLOAD_MAX_BYTES=10485760
PINNING_TOKEN=
PINNING_API_URL=
PINNING_PROJECT_ID=

# Stable Arweave publication through Irys
RELEASE_CHANNEL=
IRYS_TOKEN=ethereum
IRYS_PRIVATE_KEY=
IRYS_RPC_URL=
IRYS_NETWORK=mainnet
