FROM node:22.22.0-alpine AS builder

RUN corepack enable && corepack prepare pnpm@11.5.3 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/sdk/package.json packages/sdk/package.json
RUN pnpm install --frozen-lockfile --filter @alterford/web... --filter @alterford/sdk...

COPY apps/web apps/web
COPY packages/sdk packages/sdk

ARG VITE_CHAIN_ID
ARG VITE_BASE_SEPOLIA_RPC_URL
ARG VITE_WALLETCONNECT_PROJECT_ID
ARG VITE_WEB3AUTH_CLIENT_ID
ARG VITE_WEB3AUTH_NETWORK
ARG VITE_GATEWAY_URL
ARG VITE_APP_URL
ARG VITE_SETTLEMENT_TOKEN_ADDRESS
ARG VITE_CREATION_BOND_POLICY_ADDRESS
ARG VITE_MARKET_FACTORY_ADDRESS
ARG VITE_BOUNTY_FACTORY_ADDRESS
ARG VITE_CHALLENGE_FACTORY_ADDRESS
ARG VITE_ALTERFORD_FORWARDER_ADDRESS
ARG VITE_BOUNTY_RECOVERY_VAULT_ADDRESS
ARG VITE_INDEXER_URL

ENV VITE_CHAIN_ID=$VITE_CHAIN_ID \
    VITE_BASE_SEPOLIA_RPC_URL=$VITE_BASE_SEPOLIA_RPC_URL \
    VITE_WALLETCONNECT_PROJECT_ID=$VITE_WALLETCONNECT_PROJECT_ID \
    VITE_WEB3AUTH_CLIENT_ID=$VITE_WEB3AUTH_CLIENT_ID \
    VITE_WEB3AUTH_NETWORK=$VITE_WEB3AUTH_NETWORK \
    VITE_GATEWAY_URL=$VITE_GATEWAY_URL \
    VITE_APP_URL=$VITE_APP_URL \
    VITE_SETTLEMENT_TOKEN_ADDRESS=$VITE_SETTLEMENT_TOKEN_ADDRESS \
    VITE_CREATION_BOND_POLICY_ADDRESS=$VITE_CREATION_BOND_POLICY_ADDRESS \
    VITE_MARKET_FACTORY_ADDRESS=$VITE_MARKET_FACTORY_ADDRESS \
    VITE_BOUNTY_FACTORY_ADDRESS=$VITE_BOUNTY_FACTORY_ADDRESS \
    VITE_CHALLENGE_FACTORY_ADDRESS=$VITE_CHALLENGE_FACTORY_ADDRESS \
    VITE_ALTERFORD_FORWARDER_ADDRESS=$VITE_ALTERFORD_FORWARDER_ADDRESS \
    VITE_BOUNTY_RECOVERY_VAULT_ADDRESS=$VITE_BOUNTY_RECOVERY_VAULT_ADDRESS \
    VITE_INDEXER_URL=$VITE_INDEXER_URL

RUN pnpm --filter @alterford/sdk build && pnpm --filter @alterford/web build

FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/health || exit 1
