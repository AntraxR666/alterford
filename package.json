{
  "name": "alterford",
  "version": "1.1.0",
  "private": true,
  "description": "Alterford Web3 prediction markets, bounties, challenges, and social entertainment ecosystem.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r --filter @alterford/sdk --filter @alterford/web --filter @alterford/indexer --filter @alterford/gateway build",
    "typecheck": "pnpm -r --filter @alterford/sdk --filter @alterford/web --filter @alterford/indexer --filter @alterford/gateway typecheck",
    "test": "pnpm -r --filter @alterford/sdk --filter @alterford/web --filter @alterford/indexer --filter @alterford/gateway test",
    "lint": "pnpm -r --filter @alterford/sdk --filter @alterford/web --filter @alterford/indexer --filter @alterford/gateway lint",
    "dev": "pnpm --filter @alterford/web dev",
    "contracts:build": "cd packages/contracts && forge build",
    "contracts:test": "cd packages/contracts && forge test",
    "contracts:coverage": "cd packages/contracts && forge coverage --ir-minimum",
    "contracts:export-abis": "node scripts/export-abis.mjs",
    "deploy:local:preflight": "node scripts/deploy-preflight.mjs --chain local",
    "deploy:local": "node scripts/deploy.mjs --chain local",
    "deploy:base-sepolia:preflight": "node scripts/deploy-preflight.mjs --chain base-sepolia",
    "deploy:base-sepolia": "node scripts/deploy.mjs --chain base-sepolia",
    "deploy:base-sepolia:verify": "node scripts/verify-contracts.mjs --chain-id 84532",
    "release:base-sepolia": "node scripts/release-base-sepolia.mjs",
    "demo:local-flow": "node scripts/demo-local-flow.mjs",
    "demo:local-challenge-flow": "node scripts/demo-local-challenge-flow.mjs",
    "indexer:env": "node scripts/write-indexer-env.mjs",
    "indexer:check": "node scripts/check-indexer.mjs",
    "gateway:start": "pnpm --filter @alterford/gateway start",
    "gateway:env": "node scripts/write-gateway-env.mjs",
    "web:env:check": "node scripts/check-frontend-env.mjs",
    "security:slither": "node scripts/security-scan.mjs slither",
    "security:echidna": "node scripts/security-scan.mjs echidna",
    "security:mythril": "node scripts/security-scan.mjs mythril",
    "security:all": "node scripts/security-scan.mjs all",
    "web:env": "node scripts/write-web-env.mjs",
    "test:web:pipeline": "vitest run scripts",
    "preflight:web": "node scripts/web-preflight.mjs",
    "build:web:static": "node scripts/build-web-static.mjs",
    "deploy:web:ipfs": "node scripts/deploy-web-ipfs.mjs",
    "deploy:web:arweave": "node scripts/deploy-web-arweave.mjs",
    "release:web:stable": "node scripts/release-web-stable.mjs"
  },
  "devDependencies": {
    "@fleek-platform/sdk": "3.7.2",
    "@irys/upload": "0.0.15",
    "@irys/upload-ethereum": "0.0.16",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "jiti": "2.7.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.10",
    "@vite-pwa/assets-generator": "^1.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "viem": "^2.31.4",
    "wagmi": "^2.15.6",
    "zustand": "^5.0.5"
  },
  "packageManager": "pnpm@11.5.3"
}
